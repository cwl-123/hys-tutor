# ===== LLM（公网版只从服务端环境变量读取，页面设置不再回传/修改 key）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
# 用于每日预算估算（元 / 百万 token），按 DeepSeek 实际价格调整
LLM_PRICE_IN_PER_M=2
LLM_PRICE_OUT_PER_M=8

# ===== 搜索（备课 Agent，可选）=====
TAVILY_API_KEY=
BOCHA_API_KEY=

# ===== 服务 =====
TZ=Asia/Shanghai
PORT=5180
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
TRUST_PROXY=1

# 本地单用户/开发免登录：仅在 NODE_ENV != production 时生效；公网不要设置
# HYS_DEV_NO_AUTH=1

# ===== 账号 =====
# 首次部署时用这个邀请码注册第一个账号，该账号自动成为管理员；注册成功后请从 env 删除
BOOTSTRAP_INVITE_CODE=
MAX_USERS=10
# 本地用 HTTP 调试生产构建时设为 0（正式 HTTPS 必须为 1）
COOKIE_SECURE=1

# ===== 数据 =====
HYS_DATA_DIR=/var/lib/hys-tutor/data
HYS_DB_PATH=/var/lib/hys-tutor/control.db

# ===== 配额（防滥用，不是付费套餐）=====
QUOTA_TOPICS_PER_DAY=5
QUOTA_LESSONS_PER_DAY=10
QUOTA_GRADES_PER_DAY=100
QUOTA_CHATS_PER_DAY=300
MAX_TOPICS_PER_USER=30
MAX_BODY_BYTES=2097152
MAX_USER_STORAGE_MB=500
# 全站每日模型预算（元），超过后暂停新备课/优化，已生成内容仍可学
DAILY_BUDGET_CNY=50
