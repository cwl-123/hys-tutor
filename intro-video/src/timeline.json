  "captions": [
    {
      "start": 1.2,
      "end": 2.7543,
      "text": "这是 hys-tutor"
    },
    {
      "start": 2.7543,
      "end": 4.9563,
      "text": "一个会跟着你持续进化的 AI 私教。"
    },
    {
      "start": 6.9063,
      "end": 8.733,
      "text": "它不只是给你一份通用大纲"
    },
    {
      "start": 8.733,
      "end": 10.8641,
      "text": "而是记住你学过什么、错在哪里"
    },
    {
      "start": 10.8641,
      "end": 11.7775,
      "text": "再决定下一课。"
    },
    {
      "start": 13.2775,
      "end": 14.7441,
      "text": "输入任何学习方向"
    },
    {
      "start": 14.7441,
      "end": 18.5938,
      "text": "AI 先联网调研，再拆出有前置依赖的知识图谱"
    },
    {
      "start": 18.5938,
      "end": 21.7102,
      "text": "你的基础和讲解偏好，也会一起进入课程。"
    },
    {
      "start": 23.2102,
      "end": 26.0688,
      "text": "每个知识点都有零到一百分的掌握分"
    },
    {
      "start": 26.0688,
      "end": 27.6767,
      "text": "红黄绿，一眼看清状态"
    },
    {
      "start": 27.6767,
      "end": 29.9993,
      "text": "前置达到八十分，下游才会解锁"
    },
    {
      "start": 29.9993,
      "end": 33.9297,
      "text": "下一课优先补当前最薄弱、也最适合现在学的内容。"
    },
    {
      "start": 35.4297,
      "end": 38.428,
      "text": "每节微课十五分钟，聚焦一到两个知识点"
    },
    {
      "start": 38.428,
      "end": 41.4263,
      "text": "公式、代码、图表和来源引用清晰呈现"
    },
    {
      "start": 41.4263,
      "end": 42.4846,
      "text": "还能划线标注"
    },
    {
      "start": 42.4846,
      "end": 46.1883,
      "text": "或者用自然语言让 AI 只改你指定的那一段。"
    },
    {
      "start": 47.8883,
      "end": 48.8653,
      "text": "课末五道题"
    },
    {
      "start": 48.8653,
      "end": 52.1869,
      "text": "客观题即时反馈，简答题由 AI 批改"
    },
    {
      "start": 52.1869,
      "end": 53.9453,
      "text": "每次加减分都有原因"
    },
    {
      "start": 53.9453,
      "end": 57.0715,
      "text": "错题和报错会成为后续备课的上下文。"
    },
    {
      "start": 58.5715,
      "end": 62.8925,
      "text": "诊断、排课、讲解、练习、反馈，形成完整闭环"
    },
    {
      "start": 62.8925,
      "end": 64.8369,
      "text": "学得越多，课程越懂你。"
    },
    {
      "start": 66.3369,
      "end": 69.9398,
      "text": "学习数据可以留在自己的机器上，也支持邀请制内测"
    },
    {
      "start": 69.9398,
      "end": 73.3789,
      "text": "hys-tutor，把任何方向，学成自己的体系。"
    }
  ]
}